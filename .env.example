# ─── OpenAI — realtime transcription + prompt synthesis ─────────────────────
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_SYNTHESIS_MODEL=gpt-5.5
OPENAI_REALTIME_TOKEN_TTL=600          # seconds, 10–7200

# ─── Cala — entity resolution + cited-source discovery ──────────────────────
# NOTE: Cala returns NO images. It resolves what the user means and returns the
# article pages it cites; we extract og:image from those. See docs/PARTNERS.md.
CALA_API_KEY=
CALA_BASE_URL=https://api.cala.ai/v1
CALA_MIN_SECONDS_BETWEEN_QUERIES=8     # debounce
CALA_CREDIT_BUDGET=1100                # hard ceiling; refuse rather than overspend

# ─── Pioneer (Fastino Labs) — the distiller and cost gate ───────────────────
PIONEER_API_KEY=
PIONEER_BASE_URL=https://api.pioneer.ai/v1
PIONEER_DISTILL_MODEL=fastino/gliner2-large-v1
PIONEER_PII_MODEL=fastino/gliner2-privacy-filter-PII-multi
DISTILL_GATE_JACCARD_THRESHOLD=0.4

# ─── fal — generation. Use an API-scoped key, never ADMIN. ──────────────────
FAL_KEY=
FAL_REFERENCE_MODEL=fal-ai/flux-pro/kontext/max/multi
FAL_FALLBACK_MODEL=fal-ai/flux/schnell
FAL_MAX_REFERENCE_IMAGES=4

# ─── Image lanes ────────────────────────────────────────────────────────────
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
IMAGE_FETCH_USER_AGENT=glia/0.1 (+https://github.com/<org>/glia)
IMAGE_FETCH_MAX_BYTES=5242880
IMAGE_FETCH_MAX_REDIRECTS=2
IMAGE_FETCH_CONNECT_TIMEOUT=3
IMAGE_FETCH_TOTAL_TIMEOUT=8
IMAGE_MIN_SHORT_EDGE=400

# ─── Aikido ─────────────────────────────────────────────────────────────────
AIKIDO_TOKEN=                          # Zen runtime
AIKIDO_BLOCK=false                     # true for the demo; default is detect-only
AIKIDO_API_CLIENT_ID=                  # public REST API → in-app security panel
AIKIDO_API_CLIENT_SECRET=
AIKIDO_API_BASE_URL=https://app.aikido.dev/api/public/v1

# ─── Application ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://glia:glia@localhost:5432/glia
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info
ENVIRONMENT=development

# ─── Frontend ───────────────────────────────────────────────────────────────
# Anything prefixed VITE_ is compiled into the PUBLIC bundle. Never a credential.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
