# Copy to .env.local only when a selected implementation needs a provider.
# Never paste real values into this file or commit them.

# ─── OpenAI — realtime transcription + prompt synthesis ─────────────────────
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_SYNTHESIS_MODEL=gpt-5.5
OPENAI_REALTIME_TOKEN_TTL=600          # seconds, 10–7200
OPENAI_REQUEST_TIMEOUT_SECONDS=8

# ─── Cala — entity resolution + cited-source discovery ──────────────────────
# NOTE: Cala returns NO images. It resolves what the user means and returns the
# article pages it cites; we extract og:image from those. See docs/PARTNERS.md.
CALA_API_KEY=
CALA_BASE_URL=https://api.cala.ai/v1
CALA_MIN_SECONDS_BETWEEN_QUERIES=8     # debounce, enforced server-side per session
CALA_CREDIT_BUDGET=1100                # hard ceiling; refuse rather than overspend
CALA_CACHE_TTL_SECONDS=3600            # cache hits never bill; re-running the demo is free
CALA_CONNECT_TIMEOUT_SECONDS=10        # connect only
CALA_REQUEST_TIMEOUT_SECONDS=90        # read; a cold knowledge/search was measured at 45.7s
CALA_ENTITY_LIMIT=5                    # rows from GET /entities

# ─── Pioneer (Fastino Labs) — the distiller and cost gate ───────────────────
PIONEER_API_KEY=
PIONEER_BASE_URL=https://api.pioneer.ai
PIONEER_DISTILL_MODEL=b520c775-127f-4db6-922c-da63b82b5020
PIONEER_PII_MODEL=fastino/gliner2-privacy-filter-PII-multi
PIONEER_REQUEST_TIMEOUT_SECONDS=15
PIONEER_MAX_RETRIES=1
PIONEER_INFERENCE_THRESHOLD=0.3
DISTILL_GATE_JACCARD_THRESHOLD=0.4

# ─── fal — generation. Use an API-scoped key, never ADMIN. ──────────────────
FAL_KEY=
FAL_REFERENCE_MODEL=fal-ai/flux-pro/kontext/max/multi
FAL_FALLBACK_MODEL=fal-ai/flux/schnell
FAL_MAX_REFERENCE_IMAGES=4

# ─── Image lanes ────────────────────────────────────────────────────────────
# Lane B runs anonymously when the Openverse credentials are absent.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
OPENVERSE_BASE_URL=https://api.openverse.org
COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
IMAGE_FETCH_USER_AGENT=glia/0.1 (+https://github.com/<org>/glia)
IMAGE_FETCH_MAX_BYTES=5242880
IMAGE_FETCH_MAX_REDIRECTS=2
IMAGE_FETCH_CONNECT_TIMEOUT=3
IMAGE_FETCH_TOTAL_TIMEOUT=8
IMAGE_MIN_SHORT_EDGE=400
# Hosts /api/image will re-serve. Suffixes, matched on label boundaries.
IMAGE_HOST_ALLOWLIST=["upload.wikimedia.org","commons.wikimedia.org","staticflickr.com","api.openverse.org"]

# ─── Discovery — how a wave of candidates is built ──────────────────────────
DISCOVERY_PAGE_SIZE=20                 # results requested per lane
DISCOVERY_LANE_TIMEOUT_SECONDS=8       # per lane; one lane failing never stops the other
DISCOVERY_MAX_RETRIES=1                # transient failures only, never a 4xx
DISCOVERY_DEBOUNCE_MS=250              # per session, per subject; dead wait before the first query
DISCOVERY_MIN_EDGE=200                 # drop anything smaller on either side
DISCOVERY_MAX_CANDIDATES=30
DISCOVERY_WAVE_SIZE=8                  # candidates per candidates.batch message
DISCOVERY_WAVE_DELAY_SECONDS=0.12      # so the grid fills in waves, not at once
DISCOVERY_LANE_STAGGER_SECONDS=0.5     # grace for a slower lane, to keep a wave mixed
DISCOVERY_LANE_MIN_RESULTS=8           # below this a lane broadens its query
DISCOVERY_LANE_MAX_ATTEMPTS=3          # rungs of the query ladder a lane may try
DISCOVERY_CACHE_SIZE=64                # in-process; the same subject makes no second request

# ─── Aikido ─────────────────────────────────────────────────────────────────
AIKIDO_TOKEN=                          # Zen runtime
AIKIDO_BLOCK=false                     # true for the demo; default is detect-only
AIKIDO_API_CLIENT_ID=                  # public REST API → in-app security panel
AIKIDO_API_CLIENT_SECRET=
AIKIDO_API_BASE_URL=https://app.aikido.dev/api/public/v1

# ─── Application ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://glia:glia@localhost:5432/glia
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info
ENVIRONMENT=development
REALTIME_DEBOUNCE_MS=200
REALTIME_MAX_MESSAGE_BYTES=64000

# Keep deterministic demo mode available throughout the day.
DEMO_MODE=fixture

# ─── Frontend ───────────────────────────────────────────────────────────────
# Anything prefixed VITE_ is compiled into the PUBLIC bundle. Never a credential.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
