t"}, "session_id": {"type": "string", "maxLength": 128, "minLength": 1, "title": "Session Id"}}, "additionalProperties": false, "type": "object", "required": ["transcript", "session_id"], "title": "DiscoverRequest"}, "DiscoverResponse": {"properties": {"status": {"type": "string", "enum": ["ok", "empty", "rate_limited", "budget_exhausted"], "title": "Status"}, "session_id": {"type": "string", "title": "Session Id"}, "subject": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Subject"}, "query": {"type": "string", "title": "Query"}, "entity": {"anyOf": [{"$ref": "#/components/schemas/CalaEntityHit"}, {"type": "null"}]}, "answer": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Answer"}, "explainability": {"items": {"$ref": "#/components/schemas/CalaExplanation"}, "type": "array", "title": "Explainability"}, "context": {"items": {"$ref": "#/components/schemas/EvidenceItem"}, "type": "array", "title": "Context"}, "entities": {"items": {"$ref": "#/components/schemas/CalaSearchEntity"}, "type": "array", "title": "Entities"}, "cached": {"type": "boolean", "title": "Cached"}, "ledger": {"$ref": "#/components/schemas/LedgerSnapshot"}, "correlation_id": {"type": "string", "title": "Correlation Id"}}, "additionalProperties": false, "type": "object", "required": ["status", "session_id", "subject", "query", "entity", "answer", "explainability", "context", "entities", "cached", "ledger", "correlation_id"], "title": "DiscoverResponse"}, "EvidenceItem": {"properties": {"id": {"type": "string", "title": "Id"}, "content": {"type": "string", "title": "Content"}, "origins": {"items": {"$ref": "#/components/schemas/CalaOrigin"}, "type": "array", "title": "Origins"}, "carried_answer": {"type": "boolean", "title": "Carried Answer"}}, "additionalProperties": false, "type": "object", "required": ["id", "content", "origins", "carried_answer"], "title": "EvidenceItem", "description": "A `context[]` item, with the explainability join already resolved.\n\n`carried_answer` is ours, not Cala's: it is true when this item's id appears in some\n`explainability[].references`, which is the salience signal the UI badges."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "LedgerSnapshot": {"properties": {"budget": {"type": "integer", "title": "Budget"}, "spent": {"type": "integer", "title": "Spent"}, "remaining": {"type": "integer", "title": "Remaining"}, "search_calls": {"type": "integer", "title": "Search Calls"}, "entity_calls": {"type": "integer", "title": "Entity Calls"}}, "additionalProperties": false, "type": "object", "required": ["budget", "spent", "remaining", "search_calls", "entity_calls"], "title": "LedgerSnapshot", "description": "Credits spent this process. `entity_calls` is counted separately because\ndocs/PARTNERS.md flags it as undocumented whether `/entities` consumes credits; we charge\nit against the budget (the safe direction) while keeping it measurable against the console."}, "RealtimeTokenRequest": {"properties": {"client_id": {"type": "string", "maxLength": 128, "minLength": 8, "title": "Client Id"}, "languages": {"items": {"type": "string", "enum": ["ca", "en", "es", "fr"]}, "type": "array", "maxItems": 4, "minItems": 1, "title": "Languages"}}, "additionalProperties": false, "type": "object", "required": ["client_id"], "title": "RealtimeTokenRequest"}, "RealtimeTokenResponse": {"properties": {"value": {"type": "string", "title": "Value"}, "expires_at": {"type": "integer", "title": "Expires At"}, "model": {"type": "string", "title": "Model"}}, "additionalProperties": false, "type": "object", "required": ["value", "expires_at", "model"], "title": "RealtimeTokenResponse"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
